AUTH_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFY=1
RESEND_API_KEY=
# Verified domain: support.cryptozei.com (Resend DNS)
EMAIL_FROM=ZEI <noreply@support.cryptozei.com>
EMAIL_REPLY_TO=support@cryptozei.com
# Ops alerts (signups / milestones / API upgrade / scale) — scripts/ops-alerts.mjs
# Forced to seamuswconnolly@gmail.com only (never seamus@cryptozei.com)
OPS_ALERT_EMAIL=seamuswconnolly@gmail.com
# Etherscan API V2 key — wallet sync across all supported EVM mainnets + USDC pay verify
ETHERSCAN_API_KEY=
# Optional: Ethereum JSON-RPC for ENS name → address (mainnet only; default: publicnode)
ETH_RPC_URL=
# CoinGecko Demo (CG-…) or Pro key — JPY history/spot fallback
COINGECKO_API_KEY=
# USDC Pro checkout (QR) — same EOA on ETH + L2s
# Chains checked: Ethereum, Base, Arbitrum, Optimism, Polygon, Avalanche, Linea
USDC_RECEIVE_ADDRESS=0xYourTreasuryAddressHere
ZEI_PRO_PRICE_USDC=20
# Local only: show “Dev: mark paid” in the pay modal (never enable in production)
ALLOW_DEV_PAY=0
# Set to 1 to show the under-construction banner (default: off)
NEXT_PUBLIC_SHOW_WIP_BANNER=0
# Google Analytics measurement ID (defaults to G-3WKMYEN081 if unset)
NEXT_PUBLIC_GA_ID=G-3WKMYEN081
